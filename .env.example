# Copy to .env; keep actual credentials and local data out of Git.
PAPERPILOT_LLM_PROVIDER=qwen
PAPERPILOT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Replace with a model available to your own account.
PAPERPILOT_LLM_MODEL=replace-with-your-model
PAPERPILOT_LLM_FALLBACK_MODELS=
PAPERPILOT_LLM_THINKING=false
PAPERPILOT_LLM_MAX_TOKENS=8000
PAPERPILOT_LLM_TIMEOUT=120
DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# Alternatively use an external credential file, outside this repository.
# PAPERPILOT_API_KEY_FILE=/path/outside/repository/provider-keys.txt

PAPERPILOT_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PAPERPILOT_QWEN_VISION_MODEL=replace-with-your-vision-model
PAPERPILOT_WORKSPACE=.paperpilot
PAPERPILOT_AGENTIC_DB=.paperpilot/runtime.sqlite3
PAPERPILOT_MEMORY_DB=.paperpilot/paper-knowledge.sqlite3
PAPERPILOT_MEMORY_NAMESPACE=default
PAPERPILOT_PAPER_ROOTS=./papers

PAPERPILOT_ENABLE_DENSE=false
PAPERPILOT_ENABLE_RERANKER=false
PAPERPILOT_ALLOW_MODEL_DOWNLOAD=false
PAPERPILOT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
PAPERPILOT_EMBEDDING_CACHE=.paperpilot/model-cache/embedding
PAPERPILOT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
PAPERPILOT_RERANKER_FILE=onnx/model_quint8_avx2.onnx
PAPERPILOT_RERANKER_REVISION=main
PAPERPILOT_RERANKER_CACHE=.paperpilot/model-cache/reranker
PAPERPILOT_RERANK_STAGE=final
PAPERPILOT_STRUCTURED_PARSER=legacy
PAPERPILOT_ALLOW_EXTERNAL_SCHOLARLY=false
PAPERPILOT_WEB_HOST=127.0.0.1
PAPERPILOT_WEB_PORT=8014
